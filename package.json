{
  "name": "comment-complexity",
  "displayName": "Comment Complexity",
  "version": "0.0.1",
  "description": "Evaluates cognitive complexity of in code comments.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "publisher": "jmusial",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "pnpm check-types && node esbuild.js --production",
    "compile": "pnpm check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile-tests": "tsc -p . --outDir out",
    "test:integration": "pnpm compile-tests && pnpm compile && vscode-test",
    "package": "vsce package --no-dependencies",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "contributes": {},
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:css",
    "onLanguage:go",
    "onLanguage:html",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:kotlin",
    "onLanguage:lua",
    "onLanguage:php",
    "onLanguage:python",
    "onLanguage:ruby",
    "onLanguage:rust",
    "onLanguage:scss",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:swift",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:yaml",
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "packageManager": "pnpm@12.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmusial/comment-complexity.git"
  },
  "homepage": "https://github.com/jmusial/comment-complexity#readme",
  "bugs": {
    "url": "https://github.com/jmusial/comment-complexity/issues"
  }
}
