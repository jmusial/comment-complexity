{
  "name": "comment-complexity",
  "displayName": "Comment Complexity",
  "version": "0.0.1",
  "description": "Evaluates cognitive complexity of in code comments.",
  "categories": [
    "Other"
  ],
  "homepage": "https://github.com/jmusial/comment-complexity#readme",
  "bugs": {
    "url": "https://github.com/jmusial/comment-complexity/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmusial/comment-complexity.git"
  },
  "publisher": "jmusial",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "pnpm check-types && node esbuild.js --production",
    "compile": "pnpm check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "compile-tests": "tsc -p . --outDir out",
    "test:integration": "pnpm compile-tests && pnpm compile && vscode-test",
    "package": "vsce package --no-dependencies",
    "fmt:check": "oxfmt --check",
    "calibrate": "esbuild scripts/calibrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/calibrate.cjs --log-level=warning && node out/calibrate.cjs",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/smoke.cjs --log-level=warning && node out/smoke.cjs"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "syllable": "^5.0.1",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "contributes": {
    "configuration": {
      "title": "Comment Complexity",
      "properties": {
        "commentComplexity.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Score comments and show the lens and hover."
        },
        "commentComplexity.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Language ids to score, like `typescript`. Empty scores every supported language."
        },
        "commentComplexity.threshold": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 10,
          "markdownDescription": "Score (0–10) from which a comment counts as complex, for `#commentComplexity.showOnlyAbove#` and `#commentComplexity.diagnostics#`."
        },
        "commentComplexity.showOnlyAbove": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show lenses only on comments scoring at or above `#commentComplexity.threshold#`."
        },
        "commentComplexity.diagnostics": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Report comments scoring at or above `#commentComplexity.threshold#` in the Problems panel, as Information."
        },
        "commentComplexity.weights": {
          "type": "object",
          "default": {},
          "markdownDescription": "How much each metric counts, overriding the calibrated weights. `0` turns a metric off.",
          "properties": {
            "nounStack": {
              "type": "number",
              "minimum": 0
            },
            "clauseCount": {
              "type": "number",
              "minimum": 0
            },
            "meanZipf": {
              "type": "number",
              "minimum": 0
            },
            "minZipf": {
              "type": "number",
              "minimum": 0
            },
            "lexicalDensity": {
              "type": "number",
              "minimum": 0
            },
            "negationCount": {
              "type": "number",
              "minimum": 0
            },
            "danglingReference": {
              "type": "number",
              "minimum": 0
            },
            "undefinedAcronyms": {
              "type": "number",
              "minimum": 0
            },
            "commentLength": {
              "type": "number",
              "minimum": 0
            },
            "fleschKincaidGrade": {
              "type": "number",
              "minimum": 0
            },
            "gunningFog": {
              "type": "number",
              "minimum": 0
            },
            "colemanLiau": {
              "type": "number",
              "minimum": 0
            },
            "averageSentenceLength": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "commentComplexity.acronymWhitelist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Acronyms your readers know, like `SQS`; they are not flagged as undefined or rare."
        },
        "commentComplexity.readabilityRamp": {
          "type": "object",
          "default": {
            "start": 20,
            "end": 40
          },
          "markdownDescription": "Readability formulas count from `start` words and fully from `end` words; they are noise on short comments.",
          "properties": {
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      }
    },
    "commands": [
      {
        "command": "commentComplexity.toggleLenses",
        "title": "Toggle Lenses",
        "category": "Comment Complexity"
      },
      {
        "command": "commentComplexity.fileReport",
        "title": "Complexity Report for File",
        "category": "Comment Complexity"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:css",
    "onLanguage:go",
    "onLanguage:html",
    "onLanguage:java",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:kotlin",
    "onLanguage:lua",
    "onLanguage:php",
    "onLanguage:python",
    "onLanguage:ruby",
    "onLanguage:rust",
    "onLanguage:scss",
    "onLanguage:shellscript",
    "onLanguage:sql",
    "onLanguage:swift",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:yaml",
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "packageManager": "pnpm@12.6.0"
}
